# syntax=docker/dockerfile:1
#
# Standalone single-target build for the `exchange-client` service. See
# Dockerfile.bot for why this exists separately from the main Dockerfile.

FROM rust:1-slim-bookworm AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN cargo build --release -p exchange-client

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*
ENV RUST_LOG=info
COPY --from=builder /app/target/release/exchange-client /usr/local/bin/exchange-client
CMD ["exchange-client"]
