# Telegram bot token (see @BotFather).
TELEGRAM_BOT_TOKEN=

# Postgres connection string.
DATABASE_URL=

# Redis connection URL used to pass market data between exchange-client and
# the score engine / bot.
REDIS_URL=redis://127.0.0.1:6379

# Public market-data provider. Supported values: binance (default), bybit.
EXCHANGE_PROVIDER=binance

# Comma-separated trading symbols exchange-client subscribes to, or ALL to
# discover every currently trading USDT perpetual future from the selected
# provider at startup. Defaults to BTCUSDT. The older single-symbol
# EXCHANGE_SYMBOL still works too.
EXCHANGE_SYMBOLS=BTCUSDT

# --- product-api ---
PRODUCT_API_PORT=8080

# Set to "false" only for local HTTP development; the session cookie is
# marked Secure by default and requires HTTPS to be sent by the browser.
COOKIE_SECURE=true

# Only needed if the web product is deployed on a different origin than
# product-api. When set, use an exact scheme+host+port.
WEB_ORIGIN=

# Comma-separated symbols the Market Scanner and System Health exchange-feed
# check look at, or ALL to discover the live set from Redis.
SCAN_SYMBOLS=BTCUSDT

# Transactional email.
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
# One-time bootstrap admin address; it stops granting admin once an admin exists.
ADMIN_BOOTSTRAP_EMAIL=
EMAIL_FROM=BOLDTRACE <noreply@boldtrace.ai>
