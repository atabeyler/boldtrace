# Telegram bot token (see @BotFather).
TELEGRAM_BOT_TOKEN=

# Supabase Postgres connection string.
DATABASE_URL=

# Redis connection URL used to pass market data between exchange-client and
# the score engine / bot.
REDIS_URL=redis://127.0.0.1:6379

# Trading symbol exchange-client subscribes to. Defaults to BTCUSDT.
EXCHANGE_SYMBOL=BTCUSDT
