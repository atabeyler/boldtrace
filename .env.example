# Telegram bot token (see @BotFather).
TELEGRAM_BOT_TOKEN=

# Supabase Postgres connection string.
DATABASE_URL=

# Redis connection URL used to pass market data between exchange-client and
# the score engine / bot.
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated trading symbols exchange-client subscribes to (grouped
# across as many WebSocket connections as needed), or ALL to track every
# currently trading USDT perpetual future (~400 symbols, resolved once at
# startup). Defaults to BTCUSDT. The older single-symbol EXCHANGE_SYMBOL
# still works too.
EXCHANGE_SYMBOLS=BTCUSDT

# --- product-api ---

# Port the Product API HTTP server listens on. Defaults to 8080.
PRODUCT_API_PORT=8080

# Set to "false" only for local HTTP development; the session cookie is
# marked Secure by default and requires HTTPS to be sent by the browser.
COOKIE_SECURE=true

# Only needed if the web product is deployed on a different origin than
# product-api (product-api serves the built web app from the same origin
# by default, which needs no CORS configuration at all). When set, must be
# an exact scheme+host+port, e.g. https://app.boldtrace.ai.
WEB_ORIGIN=

# Comma-separated symbols the Market Scanner and System Health's
# exchange-feed check look at, or ALL to discover the live set from Redis
# directly (no need to keep this in sync with EXCHANGE_SYMBOLS above).
# Defaults to BTCUSDT.
SCAN_SYMBOLS=BTCUSDT

# Resend API key for transactional email (registration/approval/location
# alerts). Sending is best-effort — omitting this just skips the email.
RESEND_API_KEY=
# Where new-registration and login-location-mismatch alerts are sent.
ADMIN_NOTIFICATION_EMAIL=
# The one email address that's auto-approved and made admin on first
# registration, so there's a way in before any admin exists to approve one.
ADMIN_BOOTSTRAP_EMAIL=
# Resend-verified sender address.
EMAIL_FROM=BOLDTRACE <noreply@boldtrace.ai>
